# Copy to .env and fill in. NEVER commit your real .env file.

# --- Exchange (only needed for LIVE trading; market data is public) ---
EXCHANGE=binanceusdm
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSWORD=            # only some exchanges need this (e.g. okx, kucoin)

# --- Optional: override symbol/timeframe without editing config.yaml ---
# BOT_SYMBOL=BTC/USDT:USDT
# BOT_TIMEFRAME=15m

# --- Optional notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=
