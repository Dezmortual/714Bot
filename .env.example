# Copy this file to .env for local development. Never commit .env.

# Optional Alpaca credentials used only for live market data in this project.
# The default config is signal-only and will not submit orders.
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here

# Optional mobile notifications. Create a Telegram bot with @BotFather,
# start a chat with it, and provide the bot token and chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional alternative to Telegram. Receives a JSON POST per signal.
ALERT_WEBHOOK_URL=

# Optional config overrides.
# BROKER_MODE=paper
